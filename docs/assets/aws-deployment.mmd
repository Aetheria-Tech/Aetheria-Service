%% AWS 배포 구조 — 포트폴리오용 SVG의 원본.

%% 출처는 infra/bin/aetheria-cdk.ts · infra/lib/*.ts 와 .github/workflows/ 입니다.
%% 코드에 없는 것은 그리지 않았습니다. 특히
%%   - Blue/Green 배포는 쓰지 않습니다. ECS 롤링 업데이트(minHealthyPercent 100 /
%%     maxHealthyPercent 200)와 배포 서킷 브레이커 자동 롤백이 전부입니다.
%%   - master 푸시 자동 배포 트리거는 주석 처리되어 있어 수동 실행(workflow_dispatch)만
%%     가능합니다. 그림도 그대로 "수동 실행"이라고 적었습니다.
%%   - SageMaker 엔드포인트 자체는 CDK 가 만들지 않습니다. 이름을 context 로 받아
%%     IAM 권한 범위와 환경변수에만 쓰이므로 점선 테두리로 구분했습니다.
%%   - 반대로 CPU 70% 타깃 오토스케일링은 app-stack.ts 에 실제로 선언되어 있어 넣었습니다.
%%   - 인터페이스 VPC 엔드포인트는 기본값이 꺼짐(enableInterfaceEndpoints=false)이라
%%     그리지 않았고, 요금이 0 인 S3 게이트웨이 엔드포인트만 그렸습니다.

%% 묶음의 기준은 CDK 스택입니다. 스택 경계가 곧 배포·롤백 단위이기 때문이고,
%% 물리적 배치(어느 서브넷에 있는지)는 노드 라벨에 적었습니다.

%% 읽는 법
%%   초록 굵은 화살표 — 배포 파이프라인이 실제로 리소스를 건드리는 경로
%%   실선            — 런타임 트래픽·의존
%%   점선            — 신뢰 관계, 비동기 업로드처럼 요청/응답이 아닌 관계

%% 색 (라이트 배경 전용)
%%   배경 #F4F8FA · 주 #065A82 · 보조 #1C7293 · 강조 #02C39A · 글자 #16213E

%% 렌더는 mermaid-cli(11.x)로 하고, 레이아웃 엔진·테마는 위 프런트매터에 박아 두었으므로
%% 별도 설정 파일 없이 `mmdc -i aws-deployment.mmd -o aws-deployment-light.svg -b transparent`
%% 로 같은 그림이 나옵니다. 그 뒤 아래 네 가지를 후처리로 넣었습니다.
%%   - 루트에 xml:space="preserve" (PowerPoint·LibreOffice 에서 영문 단어 사이 공백 유지)
%%   - 라벨 뒤 배경을 불투명 #F4F8FA 로 (선이 글자를 관통하지 않게)
%%   - viewBox 를 가로·세로 25% 넓혀 사방 여백 확보 (글자 잘림 방지)
%%   - 배경을 CSS 가 아닌 실제 rect 로, 굵은 화살표의 화살촉을 강조색 사본 마커로

flowchart LR
    subgraph LOCAL["로컬"]
        PUSH["코드 푸시 · PR"]
        CDKCLI["cdk deploy --all<br/>사람이 직접 실행<br/>앱 배포와 트리거를 분리"]
    end

    subgraph GH["GitHub Actions"]
        subgraph ICI["Infra CI — infra/** 경로 필터"]
            I1["npm ci → tsc --noEmit<br/>→ CDK 단언 테스트 · jest"]
        end
        subgraph DEP["Deploy to ECS — workflow_dispatch 수동 실행"]
            W1["./gradlew test"]
            W2["OIDC 임시 자격증명<br/>액세스 키 없음"]
            W3["docker build · ECR push<br/>태그 = git SHA"]
            W4["태스크 정의 새 리비전<br/>image 교체 · command 삭제"]
            W5["update-service"]
            W6["wait services-stable<br/>헬스체크 실패 시 자동 롤백"]
            W1 --> W2 --> W3 --> W4 --> W5 --> W6
        end
    end

    subgraph AWS["AWS 계정 · ap-northeast-2 — CDK가 합성한 CloudFormation 스택 4개"]
        subgraph CICD["AetheriaCicdStack — 배포 권한"]
            OIDC["GitHub OIDC 공급자<br/>sub = repo:소유자/저장소<br/>:ref:refs/heads/master"]
            ROLE["배포 역할<br/>ECR push · RegisterTaskDefinition<br/>UpdateService<br/>PassRole 은 태스크·실행 역할 2개로만"]
            OIDC -.->|"신뢰"| ROLE
        end

        subgraph APPS["AetheriaAppStack — 실행 계층"]
            ECR["ECR aetheria-backend<br/>태그 불변 · 최근 10개만 보관"]
            ALB["ALB · public 서브넷<br/>헬스체크 /actuator/health/alb<br/>idle 620s — SSE 대비"]
            SVC["ECS Fargate 서비스 · private-app 서브넷<br/>desired 1 · 0.5 vCPU / 1GB<br/>롤링 100 / 200 · 서킷 브레이커 자동 롤백"]
            SCALE["CPU 70% 타깃 오토스케일링<br/>1 → 2 태스크"]
            LOGS["CloudWatch Logs<br/>/aetheria/backend · 30일"]
            ECR ==>|"이미지 pull"| SVC
            ALB --> SVC
        end

        subgraph DATA["AetheriaDataStack — private-data 격리 서브넷"]
            RDS["RDS MySQL 8.0 · t4g.micro<br/>단일 AZ · gp3 · 백업 7일"]
            REDIS["ElastiCache Redis 단일 노드<br/>cache.t4g.micro"]
            SECRET["Secrets Manager<br/>aetheria/rds · aetheria/app<br/>컨테이너에 시크릿으로 주입"]
        end

        subgraph PIPEG["AetheriaAppStack — 비동기 추론 파이프라인 리소스"]
            S3B["S3 ai-requests<br/>inputs/ · outputs/ · 30일 만료"]
            SNSQ["SNS 성공 · 실패 토픽<br/>raw delivery"]
            SQSQ["SQS ai-notifications<br/>가시성 5분 · DLQ 3회<br/>백엔드 @SqsListener 가 소비"]
            SM["SageMaker 비동기 엔드포인트<br/>CDK 밖 · 이름만 context 로 주입"]
            SNSQ --> SQSQ
        end

        subgraph NET["AetheriaNetworkStack — 모든 리소스가 올라가는 기반"]
            VPC["VPC 10.0.0.0/16 · 2 AZ<br/>public · private-app · private-data"]
            NAT["NAT Gateway ×1<br/>외부 API 아웃바운드"]
            S3EP["S3 게이트웨이 엔드포인트<br/>ECR 레이어 · 추가 요금 0"]
            SG["보안그룹 4개<br/>인터넷→ALB · ALB→8080<br/>App→3306 · 6379"]
        end
    end

    CLIENT["클라이언트"]

    PUSH --> I1
    PUSH --> W1
    CDKCLI ==>|"인프라 변경은 사람 손으로"| AWS
    W2 ==>|"AssumeRoleWithWebIdentity"| ROLE
    W3 ==>|"이미지 push"| ECR
    W5 ==>|"새 태스크 정의로 서비스 갱신"| SVC
    CLIENT --> ALB
    SVC --> RDS
    SVC --> REDIS
    SVC --- SCALE
    SVC --> LOGS
    SVC -.->|"프롬프트 업로드"| S3B

